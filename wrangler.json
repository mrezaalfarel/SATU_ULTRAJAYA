{
  "name": "satu-ultrajaya",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-01-01",
  "keep_vars": true,
  "build": {
    "command": "python3 src/build.py"
  },
  "assets": {
    "directory": "./pages",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/private/*",
      "/_worker.js"
    ]
  }
}
